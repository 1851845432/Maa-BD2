{
    "interface_version": 2,
    "name": "Maa-DB2",
    "description": "棕色尘埃2 小组手 ",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "github": "https://github.com/1851845432/Maa-DB2",
    "version": "1.0.0",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "BrownDust II",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "controller": [
                "桌面端"
            ],
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "EnterGameLoop",
            "default_check": true,
            "description": "启动游戏"
        },
        {
            "name": "我的小屋",
            "entry": "我的小屋签到",
            "default_check": true
        },
        {
            "name": "公会签到",
            "entry": "开始公会签到任务",
            "default_check": true
        },
        {
            "name": "街机游戏签到",
            "entry": "开始街机游戏签到任务",
            "default_check": true
        },
        {
            "name": "经营管理收菜任务",
            "entry": "经营管理收菜任务",
            "default_check": true
        },
        {
            "name": "每日抽抽乐",
            "entry": "每日抽抽乐",
            "default_check": true
        },
        {
            "name": "快速狩猎",
            "entry": "快速狩猎",
            "default_check": true,
            "option": [
                "免费米饭刷取关卡选择",
                "免费火把刷取关卡选择"
            ]
        },
        {
            "name": "活动关卡自动战斗",
            "entry": "活动关卡自动战斗",
            "default_check": true
        },
        {
            "name": "装备分解精炼任务",
            "entry": "装备分解精炼任务",
            "default_check": true
        },
        {
            "name": "每日自动吸收召集",
            "entry": "每日自动吸收召集",
            "default_check": true
        },
        {
            "name": "自动竞技场任务",
            "entry": "自动竞技场任务",
            "default_check": true
        }
    ],
    "option": {
        "活动关卡战斗难度选择": {
            "label": "活动关卡战斗难度选择",
            "type": "select",
            "description": "选择活动关卡战斗难度",
            "default_case": "普通战斗",
            "cases": [
                {
                    "name": "普通战斗",
                    "pipeline_override": {
                        "选择战斗模式": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "普通战斗"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "挑战战斗",
                    "pipeline_override": {
                        "选择战斗模式": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "挑战战斗"
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "免费米饭刷取关卡选择": {
            "label": "免费米饭刷取关卡选择",
            "type": "input",
            "inputs": [
                {
                    "name": "关卡名称",
                    "description": "请输入希望刷取的关卡名称,默认刷守山人休息处",
                    "pipeline_type": "string",
                    "default": "守山人休息处"
                }
            ],
            "pipeline_override": {
                "狩猎场地选择": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{关卡名称}"
                            ]
                        }
                    }
                }
            }
        },
        "免费火把刷取关卡选择": {
            "label": "免费火把刷取关卡选择",
            "type": "select",
            "description": "选择免费火把刷取的关卡",
            "default_case": "暗之洞穴",
            "cases": [
                {
                    "name": "暗之洞穴",
                    "pipeline_override": {
                        "选择属性洞穴": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "暗之洞穴"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "光之洞穴",
                    "pipeline_override": {
                        "选择属性洞穴": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "光之洞穴"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "水之洞穴",
                    "pipeline_override": {
                        "选择属性洞穴": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "水之洞穴"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "火之洞穴",
                    "pipeline_override": {
                        "选择属性洞穴": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "火之洞穴"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "风之洞穴",
                    "pipeline_override": {
                        "选择属性洞穴": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "风之洞穴"
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}