{
    "interface_version": 2,
    "name": "Maa-DB2",
    "description": "棕色尘埃2 小组手 ",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "github": "https://github.com/1851845432/Maa-DB2",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "BrownDust II",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "controller": [
                "桌面端"
            ],
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "EnterGameLoop",
            "default_check": true,
            "description": "启动游戏"
        },
        {
            "name": "我的小屋",
            "entry": "日常任务",
            "default_check": true
        }
    ],
    "option": {}
}