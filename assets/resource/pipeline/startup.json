{
    "EnterGameLoop": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "pre_delay": 2000,
        "max_hit": 3,
        "next": [
            "ClickConfirm"
        ],
        "on_error": [
            "LoginTimeoutCheck"
        ]
    },
    "ClickConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "CONFIRM"
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 2000,
        "focus": {
            "Node.Recognition.Succeeded": "检测到 CONFIRM，正在点击..."
        },
        "next": [
            {
                "name": "ClickTouchToStart",
                "jump_back": true
            }
        ],
        "on_error": [
            "EnterGameLoop"
        ]
    },
    "ClickTouchToStart": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "TOUCH TO START"
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_delay": 2000,
        "focus": {
            "Node.Recognition.Succeeded": "检测到 TOUCH TO START，正在点击..."
        },
        "next": [
            "回到主界面"
        ],
        "on_error": [
            "ClickConfirm"
        ]
    },
    "LoginTimeoutCheck": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "CONFIRM|TOUCH TO START"
            }
        },
        "action": {
            "type": "StopTask",
            "param": {}
        },
        "focus": {
            "Node.Recognition.Succeeded": "登录超时：重试次数超限，仍未进入主界面"
        }
    },
    "TaskCompleted": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "ClickKey",
            "param": {
                "key": [
                    48
                ]
            }
        },
        "focus": {
            "Node.Action.Starting": "任务完成，停止运行"
        }
    },
    "回到主界面": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    0,
                    0,
                    0,
                    0
                ]
            }
        },
        "next": [
            "TaskCompleted"
        ]
    }
}